# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & verification scripts
/coverage
/scripts/
*.test.ts
*.spec.ts

# planning, scratch & internal agent artifacts
implementation_plan*.md
walkthrough*.md
*.plan.md

# next.js build output
/.next/
/out/

# production
/build

# media uploads & user-generated content (keep directory with .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (protect secrets; keep clean template only)
.env*
!.env.example

# deployment & ide tooling
.vercel
.idea
.vscode

# typescript
*.tsbuildinfo
next-env.d.ts
