# ==============================================================================
# GMDware v1.0 — Production Environment Template
# ==============================================================================
# Configure these variables in your deployment platform (e.g. Vercel Project Settings)
# or populate in .env.production with secure, high-entropy production values.
#
# IMPORTANT:
# - NEVER commit real credentials, passwords, or secrets to Git.
# - Generate AUTH_SECRET with at least 32 cryptographically random characters:
#     openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Server-Only — Confidential)
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string (pooled connection recommended for serverless):
# postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC AUTHENTICATION (Server-Only — Confidential)
# ------------------------------------------------------------------------------
# Symmetric secret used to sign and verify administrative JWT session tokens (min 32 chars)
AUTH_SECRET=

# Initial administrative account credentials for initial provisioning & bootstrapping
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session token expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. STORAGE & MEDIA ASSETS (Server-Only — Optional for initial deployment)
# ------------------------------------------------------------------------------
# Storage provider adapter:
# - "local" (default for local development on your machine)
# - "none" or leave blank (safe read-only mode for Vercel without R2 credentials)
# - "r2" (Cloudflare R2 object storage for production persistent uploads)
STORAGE_PROVIDER=none

# Optional: Cloudflare R2 Credentials (leave blank if deploying without R2 initially)
# Required ONLY when enabling Cloudflare R2 (STORAGE_PROVIDER=r2):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN URL or custom domain mapped to bucket (e.g. https://pub-xxxx.r2.dev or https://media.gmdware.com)
R2_PUBLIC_URL=

# Optional: Local storage fallback (for local development when STORAGE_PROVIDER=local)
STORAGE_LOCAL_PATH=./public/uploads
STORAGE_PUBLIC_BASE_URL=/uploads

# ------------------------------------------------------------------------------
# 4. IN-MEMORY RATE LIMITING (Server-Only)
# ------------------------------------------------------------------------------
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=120
# Sliding window duration in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE CONFIGURATION (Exposed to Client Browser)
# ------------------------------------------------------------------------------
# Canonical production base URL (used for metadataBase, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://gmdware.com

# Public brand name displayed across templates
NEXT_PUBLIC_SITE_NAME=GMDware

# Default platform locale
NEXT_PUBLIC_DEFAULT_LOCALE=en
