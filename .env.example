# ==============================================================================
# GMDware v1.0 — Production Environment Template
# ==============================================================================
# Configure these variables in your deployment platform (e.g. Vercel Project Settings)
# or populate in .env.production with secure, high-entropy production values.
#
# IMPORTANT:
# - NEVER commit real credentials, passwords, or secrets to Git.
# - Generate AUTH_SECRET with at least 32 cryptographically random characters:
#     openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Server-Only — Confidential)
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string (pooled connection recommended for serverless):
# postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC AUTHENTICATION (Server-Only — Confidential)
# ------------------------------------------------------------------------------
# Symmetric secret used to sign and verify administrative JWT session tokens (min 32 chars)
AUTH_SECRET=

# Initial administrative account credentials for initial provisioning & bootstrapping
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session token expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. STORAGE & MEDIA ASSETS (Server-Only — Persistent Production Storage)
# ------------------------------------------------------------------------------
# Storage provider adapter:
# - "database" (Recommended zero-config persistent storage for Vercel — stores WebP in PostgreSQL)
# - "r2" (Cloudflare R2 S3-compatible object storage — requires R2 credentials below)
# - "local" (Default for local development on your machine: writes to ./public/uploads)
# - "disabled" (Explicitly pauses media uploads)
STORAGE_PROVIDER=database

# Cloudflare R2 Credentials (Required when STORAGE_PROVIDER=r2):
# Obtain from Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN URL or custom domain mapped to bucket (e.g. https://pub-xxxx.r2.dev or https://media.gmdware.com)
R2_PUBLIC_URL=

# Optional: Local storage settings (used when STORAGE_PROVIDER=local in development)
STORAGE_LOCAL_PATH=./public/uploads
STORAGE_PUBLIC_BASE_URL=/uploads

# ------------------------------------------------------------------------------
# 4. IN-MEMORY RATE LIMITING (Server-Only)
# ------------------------------------------------------------------------------
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=120
# Sliding window duration in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. N8N WORKFLOW WEBHOOK (Server-Only — Optional)
# ------------------------------------------------------------------------------
# Target n8n webhook endpoint to receive inbound contact/lead events
N8N_WEBHOOK_URL=
# Shared secret or authentication token sent with webhook dispatch
N8N_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. PUBLIC SITE CONFIGURATION (Exposed to Client Browser)
# ------------------------------------------------------------------------------
# Canonical production base URL (used for metadataBase, OpenGraph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=https://gmdware.com

# Public brand name displayed across templates
NEXT_PUBLIC_SITE_NAME=GMDware

# Default platform locale
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ------------------------------------------------------------------------------
# 7. INBOUND INQUIRY EMAIL NOTIFICATIONS (Server-Only — gmdware@gmail.com)
# ------------------------------------------------------------------------------
# Target inbox to receive formatted client inquiry notifications
NOTIFICATION_EMAIL=gmdware@gmail.com
EMAIL_FROM="GMDware Studio <notifications@gmdware.com>"
# SMTP credentials (e.g. Gmail App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gmdware@gmail.com
SMTP_PASS=
